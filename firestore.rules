rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(
          /databases/$(database)/documents/admins/$(request.auth.uid)
        );
    }

    // ===============================
    // ADMINISTRADORES
    // ===============================

    match /admins/{uid} {
      allow get: if signedIn()
        && request.auth.uid == uid;

      allow list, create, update, delete: if false;
    }

    // ===============================
    // NOMBRE -> EMAIL INTERNO
    // ===============================

    match /loginAliases/{loginKey} {
      // El usuario todavía no está autenticado
      // cuando necesita averiguar su email interno.
      allow get: if true;

      allow list, create, update, delete: if false;
    }

    // ===============================
    // PERFILES PÚBLICOS
    // ===============================

    match /profiles/{uid} {
      allow read: if signedIn();

      // Se crean mediante Cloud Functions.
      allow create, update, delete: if false;
    }

    // ===============================
    // LIKES ACTUALES
    // ===============================

    match /likes/{likeId} {

      allow read: if isAdmin()
        || (
          signedIn()
          && resource.data.fromUid == request.auth.uid
        );

      allow create: if signedIn()

        && request.resource.data.keys().hasOnly([
          'fromUid',
          'targetUid',
          'createdAt'
        ])

        && request.resource.data.fromUid
          == request.auth.uid

        && request.resource.data.targetUid is string

        && request.resource.data.targetUid
          != request.auth.uid

        && likeId ==
          request.auth.uid
          + '_'
          + request.resource.data.targetUid

        && exists(
          /databases/$(database)/documents/profiles/$(request.resource.data.targetUid)
        )

        && request.resource.data.createdAt
          == request.time;

      allow update: if false;

      allow delete: if signedIn()
        && resource.data.fromUid == request.auth.uid;
    }

    // ===============================
    // HISTORIAL
    // ===============================

    match /likeEvents/{eventId} {

      allow read: if isAdmin();

      allow create: if signedIn()

        && request.resource.data.keys().hasOnly([
          'fromUid',
          'targetUid',
          'action',
          'createdAt'
        ])

        && request.resource.data.fromUid
          == request.auth.uid

        && request.resource.data.targetUid is string

        && request.resource.data.targetUid
          != request.auth.uid

        && (
          request.resource.data.action == 'like'
          || request.resource.data.action == 'unlike'
        )

        && request.resource.data.createdAt
          == request.time;

      allow update, delete: if false;
    }
  }
}